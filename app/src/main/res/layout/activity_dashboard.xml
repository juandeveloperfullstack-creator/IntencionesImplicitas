<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicios 6 al 12 - Intenciones Implícitas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnLlamar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llamar por teléfono"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar Correo Electrónico"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ej 8: Mostrar Ubicación en Google Maps"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCompartir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ej 9: Compartir Texto"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ej 10: Seleccionar Contacto"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ej 11: Abrir Archivo PDF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ej 12: Abrir Página Web"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvResultadoDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado / Info:"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
